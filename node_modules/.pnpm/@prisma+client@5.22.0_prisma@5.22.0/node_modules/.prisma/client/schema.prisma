// packages/database/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ==========================================
// 1. ENUMS (LOCKED DOMAIN CONSTANTS)
// ==========================================

enum UserRole {
  FOUNDER
  MANUFACTURER_OWNER
  QC_AUDITOR
  PLATFORM_ADMIN
}

enum ProductCategory {
  APPAREL_TEXTILES
  CUSTOM_PACKAGING
}

enum ProfileClaimStatus {
  UNCLAIMED_PUBLIC_RECORD
  CLAIM_PENDING_VERIFICATION
  CLAIMED_VERIFIED
  DISPUTED_OR_HIDDEN
}

enum VerificationSource {
  GST_PUBLIC_REGISTRY
  MSME_UDYAM_PORTAL
  INDUSTRIAL_ESTATE_DIRECTORY
  PHYSICAL_VIDEO_AUDIT
}

enum RfqStatus {
  DRAFT
  OPEN_FOR_MATCHING
  QUOTES_RECEIVED
  SAMPLE_IN_PROGRESS
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  INVITED_BY_CONCIERGE
  NDA_SIGNED_VIEWED
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

// ==========================================
// 2. USERS, AUTH.JS & DPDP CONSENT
// ==========================================

model User {
  id               String    @id @default(uuid()) @db.Uuid
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  role             UserRole  @default(FOUNDER)
  organizationName String?

  // Encrypted phone (AES-256-GCM) - never exposed publicly
  encryptedPhone String?

  // Relations
  accounts         Account[]
  sessions         Session[]
  claimedFactories ManufacturerProfile[] @relation("ClaimedByUser")
  founderRfqs      RfqProject[]
  ndaSignatures    NdaAcceptance[]
  consentLogs      DpdpConsentLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. PRE-BUILT MANUFACTURER DIRECTORY & GENUINE SCORE
// ==========================================

model ManufacturerProfile {
  id                String  @id @default(uuid()) @db.Uuid
  slug              String  @unique // e.g., "shree-tex-exports-panipat"
  legalBusinessName String
  tradeName         String?

  // Official Government Identifiers
  gstin                   String? @unique
  udyamRegistrationNo     String? @unique
  isConfirmedManufacturer Boolean @default(false) // True ONLY if GST Nature == Manufacturing
  gstBusinessNatureRaw    String? // Raw text from GST portal for transparency
  yearsInBusiness         Int     @default(0)

  // Location & Hub Clustering
  city                  String // e.g., "Panipat", "Ludhiana", "Noida"
  state                 String // e.g., "Haryana", "Punjab", "Uttar Pradesh"
  industrialZone        String? // e.g., "Sector 29 Part-II HSIIDC"
  fullRegisteredAddress String  @db.Text
  latitude              Float?
  longitude             Float?

  // USP, Capabilities & Startup Fit
  category              ProductCategory
  primaryUsp            String          @db.VarChar(200) // e.g., "350-450 GSM Heavyweight Cotton Hoodies & Tote Bags"
  specializedProducts   String[] // ["Canvas Tote Bags", "Organic Cotton Pouches"]
  machineryList         Json? // Verified machinery JSON
  certifications        String[] // ["ISO_9001", "GOTS", "SEDEX"]
  estimatedMinMoq       Int             @default(100)
  estimatedLeadTimeDays Int             @default(21)
  catalogFocusRatio     Float           @default(0.0) // 0.0 to 1.0 (filters out multi-item traders)

  // Genuine Score Engine (0 - 100) & Transparent Breakdown
  genuineScore          Int      @default(0)
  gstManufacturingPts   Int      @default(0) // Max 35
  industrialLocationPts Int      @default(0) // Max 20
  catalogFocusPts       Int      @default(0) // Max 25
  trackRecordPts        Int      @default(0) // Max 20
  trustBadges           String[] // Human-readable facts shown on UI
  redFlagsDetected      String[] // Internal warnings from AI review analysis

  // Private Contact Vault (DPDP Shielded - Only used by Concierge Engine)
  corporateEmail      String?
  encryptedClaimPhone String? // AES-256-GCM encrypted
  publicWebsiteUrl    String?
  googlePlaceId       String? @unique

  // Claim & Compliance State
  claimStatus         ProfileClaimStatus   @default(UNCLAIMED_PUBLIC_RECORD)
  verificationSources VerificationSource[]
  claimedByUserId     String?              @db.Uuid
  claimedByUser       User?                @relation("ClaimedByUser", fields: [claimedByUserId], references: [id])
  lastVerifiedAt      DateTime             @default(now())

  // Vector Embedding for AI Matching (1536 dims for OpenAI / 768 for Gemini)
  capabilityEmbedding Unsupported("vector(768)")?

  // Relations
  quotes           QuoteBid[]
  ndaAcceptances   NdaAcceptance[]
  takedownRequests TakedownRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, genuineScore(sort: Desc)])
  @@index([city, category])
  @@index([claimStatus])
}

// ==========================================
// 4. FOUNDER RFQ, IP VAULT & CLICKWRAP NDA
// ==========================================

model RfqProject {
  id        String @id @default(uuid()) @db.Uuid
  founderId String @db.Uuid
  founder   User   @relation(fields: [founderId], references: [id])

  title                  String // e.g., "300 Custom Heavyweight Canvas Tote Bags with Puff Print"
  category               ProductCategory
  publicAnonSummary      String          @db.Text // Safe summary shown BEFORE factory signs NDA
  detailedSpecsProtected String          @db.Text // Revealed ONLY after NdaAcceptance

  targetQuantityMoq  Int
  targetUnitPriceInr Decimal   @db.Decimal(10, 2)
  deliveryCity       String
  requireNda         Boolean   @default(true)
  status             RfqStatus @default(OPEN_FOR_MATCHING)

  // Relations
  attachments    RfqAttachment[]
  ndaAcceptances NdaAcceptance[]
  quotes         QuoteBid[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([founderId, status])
  @@index([category, status])
}

model RfqAttachment {
  id    String     @id @default(uuid()) @db.Uuid
  rfqId String     @db.Uuid
  rfq   RfqProject @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  fileName          String
  r2ObjectKey       String // Private Cloudflare R2 / S3 key (never a public URL)
  fileSha256Hash    String // Cryptographic proof of Founder's IP ownership & timestamp
  requiresNdaToView Boolean @default(true)

  createdAt DateTime @default(now())
}

model NdaAcceptance {
  id             String              @id @default(uuid()) @db.Uuid
  rfqId          String              @db.Uuid
  rfq            RfqProject          @relation(fields: [rfqId], references: [id])
  manufacturerId String              @db.Uuid
  manufacturer   ManufacturerProfile @relation(fields: [manufacturerId], references: [id])
  signedByUserId String              @db.Uuid
  signedByUser   User                @relation(fields: [signedByUserId], references: [id])

  ndaDocumentHash String // Hash of the exact NDA legal text agreed to
  signerIpHash    String // SHA-256 of signer IP
  signedAt        DateTime @default(now())

  @@unique([rfqId, manufacturerId])
}

model QuoteBid {
  id             String              @id @default(uuid()) @db.Uuid
  rfqId          String              @db.Uuid
  rfq            RfqProject          @relation(fields: [rfqId], references: [id])
  manufacturerId String              @db.Uuid
  manufacturer   ManufacturerProfile @relation(fields: [manufacturerId], references: [id])

  unitPriceInr      Decimal     @db.Decimal(10, 2)
  sampleCostInr     Decimal     @db.Decimal(10, 2)
  toolingOrSetupInr Decimal     @default(0) @db.Decimal(10, 2)
  estimatedLeadDays Int
  notes             String?     @db.Text
  status            QuoteStatus @default(INVITED_BY_CONCIERGE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rfqId, manufacturerId])
}

// ==========================================
// 5. COMPLIANCE, SAFE HARBOR & CERT-IN AUDIT LOGS
// ==========================================

model DpdpConsentLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id])
  consentPurpose String // e.g., "FOUNDER_RFQ_SHARING", "FACTORY_PROFILE_CLAIM"
  policyVersion  String   @default("v1.0-2026")
  ipHash         String
  grantedAt      DateTime @default(now())
}

model TakedownRequest {
  id             String              @id @default(uuid()) @db.Uuid
  manufacturerId String              @db.Uuid
  manufacturer   ManufacturerProfile @relation(fields: [manufacturerId], references: [id])
  requesterEmail String
  reason         String              @db.Text // "INCORRECT_USP", "OPT_OUT_PUBLIC_LISTING"
  isResolved     Boolean             @default(false)
  createdAt      DateTime            @default(now())
}

model SecurityAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actionName  String // e.g., "NDA_SIGNED", "R2_PRESIGNED_URL_GENERATED", "PROFILE_CLAIMED"
  actorUserId String // UUID or "ANONYMOUS" / "COLLECTOR_AGENT"
  ipHash      String
  metadata    Json?
  occurredAt  DateTime @default(now()) // Synced to IST/UTC NTP for CERT-In 180-day compliance

  @@index([actionName, occurredAt])
  @@index([actorUserId])
}
